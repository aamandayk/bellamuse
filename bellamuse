</section>

<!-- ============ GALERIA ============ -->
<section class="galeria" id="galeria">
  <div class="wrap">
    <div class="topo">
      <h2>Um pouco do nosso dia a dia</h2>
      <p class="lead">Bastidores, potinhos prontos e momentos doces. Substitua os espaços abaixo pelas suas fotos.</p>
    </div>
    <div class="grade">
      <!-- Cada .slot aceita: <img src="imagens/galeria1.jpg" alt="descrição"> -->
      <div class="slot g1" role="img" aria-label="Foto 1">Foto 1<small>imagens/galeria1.jpg</small></div>
