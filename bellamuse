<!-- ============ CONTATO / PEDIDOS ============ -->
<section class="contato" id="contato">
  <div class="wrap">
    <div>
      <h2>Faça seu pedido</h2>
      <p class="lead">Preencha o formulário e o pedido segue pronto para o nosso WhatsApp. Se preferir, chame direto.</p>
      <div class="contatos">
        <!-- TROQUE o número abaixo (formato: 55 + DDD + número) -->
