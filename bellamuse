<footer>
  <div class="wrap">
    <div>
      <a class="logo" href="#inicio">Bellamuse</a>
      <p>Mousses artesanais feitas com carinho.</p>
    </div>
    <ul>
      <li>WhatsApp: (41) 99999-9999</li>
      <li>Instagram: @bellamuse</li>
      <li>Todos os dias, das 9h às 18h</li>
    </ul>
    <p class="copy">© 2026 Bellamuse. Projeto desenvolvido para a disciplina de Empreendedorismo.</p>
  </div>
</footer>

<script>
  // TROQUE AQUI pelo número do WhatsApp da Bellamuse (55 + DDD + número, só dígitos)
  const WHATSAPP = "5541999999999";
  const PRECOS = {"Maracujá":5, "Limão":5, "Chocolate":6};

  // Menu no celular
  const btn = document.getElementById("menuBtn"), menu = document.getElementById("menu");
  btn.addEventListener("click", () => {
    const aberto = menu.classList.toggle("aberto");
    btn.setAttribute("aria-expanded", aberto);
  });
  menu.addEventListener("click", e => { if (e.target.tagName === "A") { menu.classList.remove("aberto"); btn.setAttribute("aria-expanded", false); } });

  // Botão "Pedir" nos cards soma 1 unidade no formulário
  document.querySelectorAll("[data-sabor]").forEach(a => {
    a.addEventListener("click", () => {
      const campo = document.getElementById("q-" + a.dataset.sabor);
      campo.value = Number(campo.value) + 1;
    });
  });

  // Envio do pedido para o WhatsApp
  document.getElementById("pedido").addEventListener("submit", e => {
    e.preventDefault();
    let total = 0, itens = [];
    for (const s in PRECOS) {
      const q = Number(document.getElementById("q-" + s).value);
      if (q > 0) { itens.push(`${q}x Mousse de ${s}`); total += q * PRECOS[s]; }
    }
    if (!itens.length) { alert("Escolha a quantidade de pelo menos um sabor."); return; }
    const msg = `Olá, Bellamuse! Meu nome é ${document.getElementById("nome").value}.\n\nQuero pedir:\n${itens.join("\n")}\n\nTotal: R$ ${total.toFixed(2).replace(".", ",")}\n${document.getElementById("entrega").value}\nObs.: ${document.getElementById("obs").value || "nenhuma"}`;
    window.open(`https://wa.me/${WHATSAPP}?text=${encodeURIComponent(msg)}`, "_blank");
  });
  document.getElementById("zapDireto").href = `https://wa.me/${WHATSAPP}`;
</script>
</body>
</html>
